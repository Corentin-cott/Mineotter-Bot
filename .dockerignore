# Dependencies & build artefacts — regenerated inside the image
node_modules
build

# VCS
.git
.gitignore
.github

# Secrets — must never enter the build context
.env
.env.*
!.env.example

# Runtime state — bind-mounted from the host at deploy time
channels.json

# Temp clone of the Otterbots framework (vendored into src/otterbots before build)
.otterbots-tmp

# IDE & editor
.idea
.vscode
*.iml

# Docs & misc
README.md
LICENSE

# OS junk
.DS_Store
Thumbs.db

# Logs
*.log
