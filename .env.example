NODE_ENV="dev"

# Project info
GIT_REPOSITORY="https://github.com/Corentin-cott/Mineotter"
PROJECT_LOGO="https://github.com/Corentin-cott/Mineotter/blob/main/imgs/logo-text.png?raw=true"
BOT_NAME="Mineotter"
BOT_COLOR="#9adeba"
VERSION="3.0.0"
BOT_LANGUAGE="FR"

## Discord bot credentials and configuration
BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_NAME=""

# API info
API_ROUTES_URL="https://otterlyapi.antredesloutres.fr/api/routes"
API_TOKEN=""

# RCON password for game server management (if applicable). Required for Minecraft servers.
# TODO: dynamically fetch RCON password from API instead of hardcoding it here
RCON_PASSWORD=""

# Discord webhooks related variables for logs
GLOBAL_WEBHOOK_URL=
ERROR_WEBHOOK_URL=
ENABLE_DISCORD_SUCCESS=false
ENABLE_DISCORD_LOGS=false
ENABLE_DISCORD_WARNS=false
ENABLE_DISCORD_ERRORS=false

# Docker socket proxy used to start/stop game containers.
# Prod (compose): tcp://docker_proxy-discord_bots:2375
# Dev (local Docker Desktop): tcp://127.0.0.1:2375
DOCKER_HOST=""

# Games this bot is allowed to manage (matches Serveur.jeu, case-insensitive).
# Comma-separated list (e.g. "Minecraft,Palworld") or "*" for no restriction.
GAMES_MANAGED="*"